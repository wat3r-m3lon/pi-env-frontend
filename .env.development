# Dev defaults: run against the built-in mock generator so the dashboard works
# without the Pi online. Flip VITE_MOCK_MODE=false (or use .env.local) to point
# at the real realtime-service on .179.
VITE_WS_URL=ws://192.168.8.179:8080/ws/readings
VITE_MOCK_MODE=true
VITE_WS_HEARTBEAT_TIMEOUT_MS=15000
